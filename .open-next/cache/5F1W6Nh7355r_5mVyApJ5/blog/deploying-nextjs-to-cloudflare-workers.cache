oduction\\\"\\n  }\\n}\"}]}]\n16:[\"$\",\"h3\",\"h3-2\",{\"children\":\"Important Configuration Options\"}]\n17:[\"$\",\"ul\",\"ul-1\",{\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"children\":[[\"$\",\"strong\",\"strong-0\",{\"children\":\"nodejs_compat\"}],\": Enables Node.js compatibility for Next.js runtime\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"children\":[[\"$\",\"strong\",\"strong-0\",{\"children\":\"assets.directory\"}],\": Points to your static assets after OpenNext build\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"children\":[[\"$\",\"strong\",\"strong-0\",{\"children\":\"compatibility_date\"}],\": Locks Worker runtime behavior to a specific date\"]}],\"\\n\"]}]\n18:[\"$\",\"h2\",\"h2-4\",{\"children\":\"Environment Variables\"}]\n19:[\"$\",\"p\",\"p-7\",{\"children\":\"For sensitive data like API keys, use Wrangler secrets:\"}]\n1a:[\"$\",\"pre\",\"pre-4\",{\"children\":[\"$\",\"$L12\",\"code-0\",{\"inline\":false,\"className\":\"language-bash\",\"node\":{\"type\":\"element\",\"tagName\":\"code\",\"properties\":{\"className\":[\"language-bash\"]},\"children\":[{\"type\":\"text\",\"value\":\"wrangler secret put RESEND_API_KEY\\nwrangler secret put DATABASE_URL\\n\"}],\"position\":{\"start\":{\"line\":78,\"column\":1,\"offset\":2075},\"end\":{\"line\":81,\"column\":4,\"offset\":2154}}},\"children\":\"wrangler secret put RESEND_API_KEY\\nwrangler secret put DATABASE_URL\"}]}]\n1b:[\"$\",\"p\",\"p-8\",{\"children\":\"These secrets are encrypted and never exposed in your code or version control.\"}]\n1c:[\"$\",\"h2\",\"h2-5\",{\"children\":\"Building and Deploying\"}]\n1d:[\"$\",\"p\",\"p-9\",{\"children\":\"Deploy your application with a single command:\"}]\n1e:[\"$\",\"pre\",\"pre-5\",{\"children\":[\"$\",\"$L12\",\"code-0\",{\"inline\":false,\"className\":\"language-bash\",\"node\":{\"type\":\"element\",\"tagName\":\"code\",\"properties\":{\"className\":[\"language-bash\"]},\"children\":[{\"type\":\"text\",\"value\":\"npm run build\\nwrangler deploy\\n\"}],\"position\":{\"start\":{\"line\":89,\"column\":1,\"offset\":2311},\"end\":{\"line\":92,\"column\":4,\"offset\":2352}}},\"children\":\"npm run build\\nwrangler deploy\"}]}]\n1f:[\"$\",\"p\",\"p-10\",{\"children\":\"OpenNext will transform your Next.js application into a format optimized for Cloudflare Workers, including:\"}]\n20:[\"$\",\"ul\",\"ul-2\",{\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"children\":\"Server-side rendering functions\"}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"children\":\"API routes\"}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"children\":\"Middleware\"}],\"\\n\",[\"$\",\"li\",\"li-3\",{\"children\":\"Static assets with proper caching headers\"}],\"\\n\"]}]\n21:[\"$\",\"h2\",\"h2-6\",{\"children\":\"Key Considerations\"}]\n22:[\"$\",\"h3\",\"h3-3\",{\"children\":\"Edge Compatibility\"}]\n23:[\"$\",\"p\",\"p-11\",{\"children\":\"Not all Next.js features work on edge runtimes. Ensure your code:\"}]\n24:[\"$\",\"ul\",\"ul-3\",{\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"children\":\"Avoids Node.js-specific APIs where possible\"}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"children\":\"Uses edge-compatible libraries\"}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"children\":\"Handles environment differences gracefully\"}],\"\\n\"]}]\n25:[\"$\",\"h3\",\"h3-4\",{\"children\":\"Cache Configuration\"}]\n26:[\"$\",\"p\",\"p-12\",{\"children\":\"Cloudflare automatically caches static assets, but you can fine-tune caching behavior:\"}]\n27:[\"$\",\"pre\",\"pre-6\",{\"children\":[\"$\",\"$L12\",\"code-0\",{\"inline\":false,\"className\":\"language-typescript\",\"node\":{\"type\":\"element\",\"tagName\":\"code\",\"properties\":{\"className\":[\"language-typescript\"]},\"children\":[{\"type\":\"text\",\"value\":\"// next.config.js\\nmodule.exports = {\\n  headers: async () => [\\n    {\\n      source: '/:path*',\\n      headers: [\\n        {\\n          key: 'Cache-Control',\\n          value: 'public, max-age=3600, s-maxage=86400'\\n        }\\n      ]\\n    }\\n  ]\\n}\\n\"}],\"position\":{\"start\":{\"line\":115,\"column\":1,\"offset\":2920},\"end\":{\"line\":130,\"column\":4,\"offset\":3175}}},\"children\":\"// next.config.js\\nmodule.exports = {\\n  headers: async () => [\\n    {\\n      source: '/:path*',\\n      headers: [\\n        {\\n          key: 'Cache-Control',\\n          value: 'public, max-age=3600, s-maxage=86400'\\n        }\\n      ]\\n    }\\n  ]\\n}\"}]}]\n28:[\"$\",\"h3\",\"h3-5\",{\"children\":\"Performance Monitoring\"}]\n29:[\"$\",\"p\",\"p-13\",{\"children\":\"Use Cloudflare's analytics dashboard to monitor:\"}]\n2a:[\"$\",\"ul\",\"ul-4\",{\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"children\":\"Request volume and error rates\"}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"children\":\"Response times by region\"}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"children\":\"Cache hit ratios\"}],\"\\n\",[\"$\",\"li\",\"li-3\",{\"children\":\"CPU time and memory usage\"}],\"\\n\"]}]\n2b:[\"$\",\"h2\",\"h2-7\",{\"children\":\"Troubleshooting Common Issues\"}]\n2c:[\"$\",\"h3\",\"h3-6\",{\"children\":\"Build Failures\"}]\n2d:[\"$\",\"p\",\"p-14\",{\"children\":\"If your build fails, check:\"}]\n2e:[\"$\",\"ul\",\"ul-5\",{\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"children\":\"Node.js version compatibility (use Node 18+)\"}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"children\":\"Ensure all dependencies support edge runtime\"}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"children\":\"Verify wrangler.jsonc syntax is valid\"}],\"\\n\"]}]\n2f:[\"$\",\"h3\",\"h3-7\",{\"children\":\"Runtime Errors\"}]\n30:[\"$\",\"p\",\"p-15\",{\"children\":\"For runtime issues:\"}]\n31:[\"$\",\"ul\",\"ul-6\",{\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"children\":[\"Check Worker logs: \",[\"$\",\"$L12\",\"code-0\",{\"inline\":true,\"className\":\"$undefined\",\"node\":{\"type\":\"element\",\"tagName\":\"code\",\"properties\":{},\"children\":[{\"type\":\"text\",\"value\":\"wrangler tail\",\"position\":{\"start\":{\"line\":155,\"column\":22,\"offset\":3643},\"end\":{\"line\":155,\"column\":37,\"offset\":3658}}}],\"position\":{\"start\":{\"line\":155,\"column\":22,\"offset\":3643},\"end\":{\"line\":155,\"column\":37,\"offset\":3658}}},\"children\":\"wrangler tail\"}]]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"children\":\"Verify environment variables are set correctly\"}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"children\":\"Test edge-compatible alternatives for Node.js APIs\"}],\"\\n\"]}]\n32:[\"$\",\"h2\",\"h2-8\",{\"children\":\"Advanced: Custom Domains\"}]\n33:[\"$\",\"p\",\"p-16\",{\"children\":\"Point your custom domain to your Worker:\"}]\n34:[\"$\",\"pre\",\"pre-7\",{\"children\":[\"$\",\"$L12\",\"code-0\",{\"inline\":false,\"className\":\"language-bash\",\"node\":{\"type\":\"element\",\"tagName\":\"code\",\"properties\":{\"className\":[\"language-bash\"]},\"children\":[{\"type\":\"text\",\"value\":\"wrangler domains add example.com\\n\"}],\"position\":{\"start\":{\"line\":163,\"column\":1,\"offset\":3833},\"end\":{\"line\":165,\"column\":4,\"offset\":3877}}},\"children\":\"wrangler domains add example.com\"}]}]\n35:[\"$\",\"p\",\"p-17\",{\"children\":\"Cloudflare automatically provisions SSL certificates for your domain.\"}]\n36:[\"$\",\"h2\",\"h2-9\",{\"children\":\"Conclusion\"}]\n37:[\"$\",\"p\",\"p-18\",{\"children\":\"Deploying Next.js to Cloudflare Workers combines the best of both worlds: the developer experience of Next.js with the global performance of edge computing. With OpenNext handling the complexity of adapting your application, you can focus on building features while your users enjoy faster load times from anywhere in the world.\"}]\n38:[\"$\",\"p\",\"p-19\",{\"children\":\"The edge computing paradigm is transforming how we think about web application deployment, and Cloudflare Workers makes it accessible to developers of all skill levels.\"}]\nd:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n9:null\nb:{\"metadata\":[[\"$\