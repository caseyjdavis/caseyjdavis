 a millisecond\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"children\":[[\"$\",\"strong\",\"strong-0\",{\"children\":\"Cost-Effective\"}],\": Pay only for what you use with generous free tier\"]}],\"\\n\",[\"$\",\"li\",\"li-3\",{\"children\":[[\"$\",\"strong\",\"strong-0\",{\"children\":\"Built-in CDN\"}],\": Static assets are automatically cached at the edge\"]}],\"\\n\",[\"$\",\"li\",\"li-4\",{\"children\":[[\"$\",\"strong\",\"strong-0\",{\"children\":\"DDoS Protection\"}],\": Enterprise-grade security included by default\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"h2\",\"h2-1\",{\"children\":\"Prerequisites\"}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"children\":\"Before you begin, ensure you have:\"}],\"\\n\",[\"$\",\"pre\",\"pre-0\",{\"children\":[\"$\",\"$L12\",\"code-0\",{\"inline\":false,\"className\":\"language-bash\",\"node\":{\"type\":\"element\",\"tagName\":\"code\",\"properties\":{\"className\":[\"language-bash\"]},\"children\":[{\"type\":\"text\",\"value\":\"npm install -g wrangler\\nwrangler login\\n\"}],\"position\":{\"start\":{\"line\":18,\"column\":1,\"offset\":794},\"end\":{\"line\":21,\"column\":4,\"offset\":844}}},\"children\":\"npm install -g wrangler\\nwrangler login\"}]}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"children\":\"You'll also need a Cloudflare account and a Next.js application ready to deploy.\"}],\"\\n\",[\"$\",\"h2\",\"h2-2\",{\"children\":\"Setting Up OpenNext\"}],\"\\n\",[\"$\",\"p\",\"p-4\",{\"children\":\"OpenNext is an open-source adapter that makes Next.js compatible with edge runtimes like Cloudflare Workers.\"}],\"\\n\",[\"$\",\"h3\",\"h3-0\",{\"children\":\"Install OpenNext\"}],\"\\n\",[\"$\",\"pre\",\"pre-1\",{\"children\":[\"$\",\"$L12\",\"code-0\",{\"inline\":false,\"className\":\"language-bash\",\"node\":{\"type\":\"element\",\"tagName\":\"code\",\"properties\":{\"className\":[\"language-bash\"]},\"children\":[{\"type\":\"text\",\"value\":\"npm install --save-dev open-next@latest\\n\"}],\"position\":{\"start\":{\"line\":31,\"column\":1,\"offset\":1084